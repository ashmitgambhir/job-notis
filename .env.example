# Copy to .env and fill in. .env is gitignored; nothing here is committed.
# Only the channels you enable need credentials.

# ---------------------------------------------------------------- SMS (Twilio)
# From https://console.twilio.com — Account SID and Auth Token on the dashboard.
SMS_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=+15551234567
# YOUR phone number, E.164 format (+1 then area code then number).
ALERT_PHONE_NUMBER=+15559876543

# --------------------------------------------------------------------- Email
EMAIL_ENABLED=false
EMAIL_PROVIDER=smtp
# Gmail: use an App Password, not your account password.
# https://myaccount.google.com/apppasswords (requires 2FA enabled)
SMTP_HOST=smtp.gmail.com
SMTP_USERNAME=you@gmail.com
SMTP_PASSWORD=
ALERT_FROM_EMAIL=you@gmail.com
ALERT_EMAIL=you@gmail.com
# Optional: your carrier's email-to-SMS gateway — free texts, no Twilio.
#   T-Mobile/Mint  5551234567@tmomail.net
#   Verizon        5551234567@vtext.com
#   AT&T           5551234567@txt.att.net
#   Google Fi      5551234567@msg.fi.google.com
ALERT_SMS_GATEWAY=
# Only if EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=

# ------------------------------------------------------------- Other channels
SLACK_ENABLED=false
SLACK_WEBHOOK_URL=

DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=

TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

WEBHOOK_ENABLED=false
GENERIC_WEBHOOK_URL=

# ------------------------------------------------------------------- Digests
DAILY_DIGEST_ENABLED=false
WEEKLY_DIGEST_ENABLED=false

# --------------------------------------------------------------- LLM (optional)
# Only used to adjudicate borderline scores, capped per cycle. Off by default.
LLM_ENABLED=false
LLM_MODEL=claude-opus-5
ANTHROPIC_API_KEY=

# ------------------------------------------------------------------ NASA only
# Free key: https://developer.usajobs.gov/apirequest/
USAJOBS_API_KEY=
USAJOBS_EMAIL=

# ------------------------------------------------------------------- Runtime
# SQLite by default. For Postgres:
#   DATABASE_URL=postgresql+psycopg://user:pass@host:5432/jobmonitor
DATABASE_URL=sqlite:///data/jobmonitor.db
LOG_LEVEL=INFO
LOG_FORMAT=console
HEALTH_PORT=8080
